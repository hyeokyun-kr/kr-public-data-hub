# KR Public Data Hub — API 키 설정
#
# 이 파일을 복사해 이름을 '.env' 로 바꾸고(같은 폴더), 각 기관에서 받은 키를 '=' 뒤에 붙여 넣으세요.
#   cp .env.example .env
# '.env' 는 .gitignore 에 들어 있어 저장소에 올라가지 않습니다. 환경변수로 넣어도 됩니다(환경변수가 먼저).
# 키는 모두 무료이며, 없는 키의 기능만 꺼지고 나머지는 그대로 씁니다.

# 국가통계포털 KOSIS — https://kosis.kr/openapi/ → 활용신청
KOSIS_API_KEY=
# 한국은행 경제통계 ECOS — https://ecos.bok.or.kr/api/ → 인증키 신청
ECOS_API_KEY=
# 금융감독원 전자공시 OpenDART — https://opendart.fss.or.kr → 인증키 신청 (회사 재무·공시·업종 비교)
OPENDART_API_KEY=
# 공공데이터포털 — https://www.data.go.kr → '공정거래위원회_기업집단포털' API 활용신청 (기업집단 화면)
DATA_GO_KR_SERVICE_KEY=

# (선택) AI 추천·의결서 AI 질문. 둘 중 하나만 있어도 됨
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
